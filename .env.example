OPENAI_API_KEY=
# Used for profile extraction, planning and screening (many calls).
OPENAI_MODEL_DEFAULT=gpt-4o-mini
# Optional: a stronger model just for cover letters + fact check.
OPENAI_MODEL_DRAFTING=
SCREENING_CONCURRENCY=8

# Optional, paid: enables the Adzuna source (keys at https://developer.adzuna.com/). Leave empty to skip it.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Defaults to sqlite at backend/jword.db
# DATABASE_URL=sqlite+aiosqlite:///./jword.db
